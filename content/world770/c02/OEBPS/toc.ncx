        <navPoint id="np_1278" playOrder="1278">
        <navLabel>
        <text>2.判处绞刑</text>
        </navLabel>
        <content src="Text/part1366.xhtml"/>
        </navPoint>
        <navPoint id="np_1279" playOrder="1279">
        <navLabel>
