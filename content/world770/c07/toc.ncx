      <navPoint class="chapter" id="num_501" playOrder="500">
        <navLabel>
          <text>Chapter 1The Three Presents of D’Artagnan the Elder第一章老达塔尼昂的三件礼物</text>
        </navLabel>
        <content src="text/part0218_split_000.html"/>
      </navPoint>
      <navPoint class="chapter" id="num_502" playOrder="501">
        <navLabel>
          <text>Chapter 2The Antechamber of M de Treville第二章特雷维尔先生的前厅</text>
        </navLabel>
        <content src="text/part0218_split_001.html"/>
      </navPoint>
      <navPoint class="chapter" id="num_503" playOrder="502">
