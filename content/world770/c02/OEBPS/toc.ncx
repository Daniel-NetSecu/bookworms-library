          </navLabel>
          <content src="Text/part0852.xhtml"/>
          </navPoint>
          <navPoint id="np_786" playOrder="786">
          <navLabel>
          <text>On punishing cowardice</text>
          </navLabel>
          <content src="Text/part0853.xhtml"/>
          </navPoint>
          <navPoint id="np_787" playOrder="787">
